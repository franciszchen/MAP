#!/usr/bin/env bash
set -ex

echo "Setting up SSH port forwarding..."

# 配置变量
REMOTE_HOST="connect.cqa1.seetacloud.com"
REMOTE_PORT="19139"
REMOTE_USER="root"
LOCAL_PORT="6006"
REMOTE_PORT_FORWARD="127.0.0.1:6006"
PASSWORD="7pG33QeFOYAc"

# 清理已存在的SSH进程和端口
cleanup() {
    echo "Cleaning up existing connections..."
    pkill -f "ssh.*$LOCAL_PORT" || true
    sleep 2
}

# 执行清理
cleanup

# 方案1：使用expect脚本实现自动输入密码
cat > ssh_connect.exp << 'EOF'
#!/usr/bin/expect -f
set timeout 30
set host [lindex $argv 0]
set port [lindex $argv 1]
set password [lindex $argv 2]

spawn ssh -o StrictHostKeyChecking=no -o ServerAliveInterval=60 -CNg -L 6006:127.0.0.1:6006 root@$host -p $port
expect "password:"
send "$password\r"
expect eof
EOF

chmod +x ssh_connect.exp

# 安装expect
apt-get update && apt-get install -y expect

# 使用expect脚本建立连接
./ssh_connect.exp "$REMOTE_HOST" "$REMOTE_PORT" "$PASSWORD" &

# 等待连接建立
echo "Waiting for SSH tunnel to establish..."
sleep 5

# 验证连接
if netstat -tulnp 2>/dev/null | grep -q ":$LOCAL_PORT"; then
    echo "SSH tunnel established successfully."
    echo "Running main program..."

    echo "Running evaluation.py..."
    python /root/capsule/code/examples/clinic/evaluation.py
else
    echo "Failed to establish SSH tunnel. Trying alternative method..."
    
    # 方案2：直接使用SSH命令（如果expect方案失败）
    ssh -o StrictHostKeyChecking=no \
        -o ServerAliveInterval=60 \
        -CNg -L $LOCAL_PORT:$REMOTE_PORT_FORWARD \
        $REMOTE_USER@$REMOTE_HOST -p $REMOTE_PORT &
    
    # 再次等待和验证
    sleep 5
    if netstat -tulnp 2>/dev/null | grep -q ":$LOCAL_PORT"; then
        echo "SSH tunnel established successfully using alternative method."
        echo "Running main program..."

        echo "Running evaluation.py..."
        python /root/capsule/code/examples/clinic/evaluation.py
    else
        echo "SSH tunnel setup failed. Debug information:"
        netstat -tulnp
        ps aux | grep ssh
        exit 1
    fi
fi

# 保持脚本运行
wait